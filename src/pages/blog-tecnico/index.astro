---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { withBase } from "../../config";

const articles = (
  await getCollection("blog-tecnico", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Blog técnico"
  description="Dictámenes y análisis técnicos de MS & Asociados dirigidos a colegas abogados y a instituciones, con vocación de intercambio académico nacional e internacional."
>
  <section class="page-hero">
    <img
      class="page-hero-watermark"
      src={withBase("/img/logo-watermark.png")}
      alt=""
      width="680"
      height="355"
      aria-hidden="true"
    />
    <div class="wrap">
      <p class="eyebrow">Blog técnico — para colegas</p>
      <h1>Doctrina, dictámenes y discusión entre pares.</h1>
      <p class="lede">
        Un espacio dirigido a abogados, académicos y organismos: análisis
        técnicos con el detalle que la divulgación general no permite. Buscamos
        el intercambio con colegas e instituciones, dentro y fuera del país.
      </p>
    </div>
  </section>

  <section class="tech-section">
    <div class="wrap">
      {
        articles.length > 0 ? (
          <div
            class="article-grid"
            style={`--cols: ${Math.min(articles.length, 3)}`}
          >
            {articles.map((article) => (
              <ArticleCard
                href={withBase(`/blog-tecnico/${article.id}`)}
                title={article.data.title}
                excerpt={article.data.excerpt}
                date={article.data.date}
                level={2}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <span class="mark">En construcción</span>
            <h2>Los primeros dictámenes técnicos se publicarán próximamente.</h2>
            <p>
              El estudio está preparando el material de esta sección. Si trabaja
              en la academia o en un organismo y le interesa colaborar,
              escríbanos.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
