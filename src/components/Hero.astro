---
import { bookingUrl } from "../config";
---

<section class="hero" id="top">
  <!-- TODO: imagen de maqueta. Reemplazar por la foto definitiva del estudio. -->
  <img
    class="hero-watermark"
    src="/img/logo-watermark.png"
    alt=""
    width="680"
    height="355"
    aria-hidden="true"
  />
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow hero-eyebrow">
        MS &amp; Asociados — Estudio Jurídico, Asunción
      </p>
      <h1>La ley, leída con precisión. <em>Defendida con carácter.</em></h1>
      <p class="lede">
        Asesoramos a personas, familias y empresas en Paraguay con criterio
        técnico, gestión ordenada de cada expediente y un trato directo, sin
        intermediarios ni letra chica.
      </p>
      <div class="hero-actions">
        <a href={bookingUrl} class="btn btn-on-dark">Agendar una consulta</a>
        <a href="#areas" class="btn btn-ghost-on-dark">Ver áreas de práctica</a>
      </div>
      <div class="hero-meta">
        <div>
          <span class="num">12+</span><span class="lbl">Años de ejercicio</span>
        </div>
        <div>
          <span class="num">300+</span><span class="lbl">Casos gestionados</span
          >
        </div>
        <div>
          <span class="num">08</span><span class="lbl">Áreas de práctica</span>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-frame">
        <span class="corner tl"></span>
        <!-- TODO: imagen de maqueta (stock). Slot 4:3 — reemplazar por la imagen que defina el estudio. -->
        <img
          src="/img/placeholder-hero.jpg"
          alt="Estatua de la justicia, símbolo del estudio MS &amp; Asociados"
          width="1400"
          height="1073"
        />
        <span class="corner br"></span>
      </div>
      <div class="hero-caption">
        <span>Fig. I — Justitia</span>
        <span>MS &amp; Asociados</span>
      </div>
    </div>
  </div>
  <div class="scale-mark">
    <svg viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="50" y1="8" x2="50" y2="76" stroke="#c6c6c6" stroke-width="1"
      ></line>
      <g class="scale-beam">
        <line x1="14" y1="34" x2="86" y2="34" stroke="#c6c6c6" stroke-width="1"
        ></line>
        <line x1="14" y1="34" x2="14" y2="50" stroke="#c6c6c6" stroke-width="1"
        ></line>
        <line x1="86" y1="34" x2="86" y2="50" stroke="#c6c6c6" stroke-width="1"
        ></line>
        <path d="M4 50 A10 12 0 0 0 24 50 Z" stroke="#c6c6c6" stroke-width="1"
        ></path>
        <path d="M76 50 A10 12 0 0 0 96 50 Z" stroke="#c6c6c6" stroke-width="1"
        ></path>
        <circle cx="50" cy="34" r="3" fill="#c6c6c6"></circle>
      </g>
      <path d="M42 76 L58 76 L54 84 L46 84 Z" fill="#c6c6c6"></path>
    </svg>
  </div>
</section>
