---
import { CONTACT, SITE, withBase } from "../config";

const year = new Date().getFullYear();
const links = [
  { href: withBase("/#nosotros"), label: "Nosotros" },
  { href: withBase("/#areas"), label: "Áreas" },
  { href: withBase("/blog"), label: "Blog" },
  { href: withBase("/blog-tecnico"), label: "Blog técnico" },
  { href: withBase("/simposios"), label: "Simposios" },
  { href: withBase("/#contacto"), label: "Contacto" },
];
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <a class="footer-brand" href={withBase("/")}>
        <img
          src={withBase("/img/logo-footer.png")}
          alt={SITE.legalName}
          style="height: 74px; width: auto"
          width="940"
          height="620"
        />
      </a>
      <nav aria-label="Navegación del pie">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.legalName}. Todos los derechos reservados.</span>
      <span>
        <a href={CONTACT.phoneHref}>{CONTACT.phoneLabel}</a> · {SITE.city}
      </span>
    </div>
  </div>
</footer>
